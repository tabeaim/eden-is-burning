# Eden Is Burning — Umgebungsvariablen
# --------------------------------------------------------------------------
# Kopiere diese Datei nach ".env.local" und trage deine Supabase-Werte ein.
# .env.local ist per .gitignore ausgeschlossen und landet NICHT auf GitHub.
#
# Werte findest du im Supabase-Dashboard unter:
#   Project Settings → API
#
# Öffentliche Werte (dürfen im Browser landen, werden in Vercel als
# Environment Variables hinterlegt):
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key

# GEHEIM — nur lokal für das einmalige Seeding (npm run seed). NICHT in Vercel,
# NICHT committen. Zu finden unter Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Optional — GIF-Suche im Messenger (kostenloser Schlüssel: developers.giphy.com).
# Ohne Schlüssel lassen sich GIFs weiterhin per Link einfügen.
NEXT_PUBLIC_GIPHY_API_KEY=
